PORT=5000
NODE_ENV=development
# dummy | product.json | supabase
FINANCIAL_PRODUCTS_SOURCE=dummy
# OpenAI 호환 또는 Gemini 중 하나. 없으면 규칙 기반 fallback 분석
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# true 이면 AI 호출 실패 시 502 (기본은 fallback)
AI_REQUIRED=false
