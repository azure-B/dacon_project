PORT=5000
NODE_ENV=development

# --- 팀장 설정: AI API KEY ---
# OpenAI 호환 키 (ChatGPT, Groq 등). 둘 중 하나만 있으면 됩니다.
OPENAI_API_KEY=
AI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gemini 키 (OPENAI_API_KEY가 없을 때 사용)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# true 이면 AI 호출 실패 시 502 (기본은 fallback)
AI_REQUIRED=false
AI_TIMEOUT_MS=25000

# dummy | product.json | supabase
FINANCIAL_PRODUCTS_SOURCE=dummy

# --- 소비내역 평가 스케줄러 (Asia/Seoul) ---
# 일간: 매일 24시(00:00) / 주간: 일요일 24시=월요일 00:00 / 월간: 말일 24시=익월 1일 00:00
EVALUATION_TZ=Asia/Seoul
EVALUATION_SCHEDULER_ENABLED=true
EVALUATION_CRON_DAILY=0 0 * * *
EVALUATION_CRON_WEEKLY=0 0 * * 1
EVALUATION_CRON_MONTHLY=0 0 1 * *
