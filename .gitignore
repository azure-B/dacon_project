# Dependencies
node_modules/
server/node_modules/

# Build output
dist/
dist-ssr/
build/

# Environment (프로젝트 전역·백엔드)
.env
.env.*
!.env.example
!**/.env.example

# Local secrets — config/ (실키만 무시, 예시는 커밋)
config/.env
config/.env.*
!config/.env.example
config/*.txt
!config/*.example.txt
config/*.pem
config/*.key
config/secrets.*

# Logs
logs/
*.log
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Vite cache
.vite/
